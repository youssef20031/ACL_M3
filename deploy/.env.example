# Copy to deploy/.env on the VM (deploy/setup-vm.sh does this for you).

# Public hostname for the site. With no domain, use the VM's public IP with
# dots replaced by dashes + .sslip.io, e.g. 140-238-12-34.sslip.io
SITE_ADDRESS=

# Neo4j runs inside the stack; pick any long random password (setup-vm.sh generates one)
NEO4J_PASSWORD=
# Optional Neo4j memory (defaults 1G / 512M suit a 4 GB VM; e.g. 2G / 1G on 8 GB+)
NEO4J_HEAP=
NEO4J_PAGECACHE=

# LLMs (all live models are on Groq)
GROQ_API_KEY=
# Optional: only used by models with provider "huggingface"
HUGGINGFACE_API_TOKEN=

# Optional avatar fallback
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Required for every state-changing endpoint (send it as X-Admin-Token): /api/admin/reload
# (the daily job), /api/data/load, /api/fixtures/load, /api/embeddings/build and
# /api/connection/*. Without it those endpoints return 404. deploy.sh generates it.
ADMIN_TOKEN=
# Optional: per-client limits on the LLM endpoint, "count/seconds" pairs (default below)
# QUERY_RATE_LIMITS=10/60,120/3600
# Optional: healthchecks.io (or compatible) ping URL; you get an email if the daily job fails
HEALTHCHECK_URL=

# Optional extra allowed CORS origins (comma-separated). Not needed when the
# frontend is served from SITE_ADDRESS by this stack.
CORS_ORIGINS=
