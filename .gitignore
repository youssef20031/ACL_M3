data/live/

# Bookmaker odds from football-data.co.uk (scripts/data/fetch_odds.py): free for private use,
# not for redistribution
data/odds/

# FPL availability and set-piece snapshots (scripts/data/fetch_fpl_snapshots.py): MIT, but 8 MB
data/fpl_snapshots.csv

# TypeScript incremental build info
*.tsbuildinfo
